@page "{id:int}"
@model dr4_at.Pages.Clientes.EditModel
@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">Editar Cliente</h3>
                <small class="text-muted">ID: @Model.Id</small>
            </div>
            <div class="card-body">
                @if (Model.Cliente != null)
                {
                    <form method="post">
                        <input type="hidden" asp-for="Id"/>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Cliente.Nome" class="form-label">Nome Completo</label>
                                    <input asp-for="Cliente.Nome" class="form-control"
                                           placeholder="Digite o nome completo"/>
                                    <span asp-validation-for="Cliente.Nome" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Cliente.Email" class="form-label">Email</label>
                                    <input asp-for="Cliente.Email" type="email" class="form-control"
                                           placeholder="exemplo@email.com"/>
                                    <span asp-validation-for="Cliente.Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>


                        <div class="d-flex justify-content-between mt-4">
                            <div>
                                <a asp-page="./Index" class="btn btn-secondary me-2">
                                    <i class="bi bi-arrow-left"></i> Voltar à Lista
                                </a>
                                <a asp-page="./Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                                    <i class="bi bi-eye"></i> Ver Detalhes
                                </a>
                            </div>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Salvar Alterações
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning">
                        <h5>Cliente não encontrado</h5>
                        <p>O cliente que você está tentando editar não foi encontrado.</p>
                        <a asp-page="./Index" class="btn btn-primary">Voltar à Lista</a>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.MensagemSucesso))
                {
                    <div class="alert alert-success mt-3">
                        <i class="bi bi-check-circle"></i> @Model.MensagemSucesso
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}