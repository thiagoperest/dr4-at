@page
@model dr4_at.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div class="text-danger" asp-validation-summary="All"></div>
            <div class="form-group mb-3">
                <label asp-for="LoginRequest.Username" class="form-label">Usuário</label>
                <input asp-for="LoginRequest.Username" class="form-control" />
                <span asp-validation-for="LoginRequest.Username" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="LoginRequest.Password" class="form-label">Senha</label>
                <input asp-for="LoginRequest.Password" type="password" class="form-control" />
                <span asp-validation-for="LoginRequest.Password" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <button type="submit" class="btn btn-primary">Entrar</button>
            </div>
        </form>
        
        <div class="mt-3">
            <small class="text-muted">
                <strong>Credenciais de teste:</strong><br />
                Usuário: admin<br />
                Senha: 123456
            </small>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}